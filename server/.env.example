PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local MongoDB
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/skillbridge?retryWrites=true&w=majority

# JWT Secrets
JWT_ACCESS_SECRET=skillbridge_jwt_access_super_secret_key_2026_production_grade
JWT_REFRESH_SECRET=skillbridge_jwt_refresh_super_secret_key_2026_production_grade
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client URL for CORS and cookies (can be comma-separated list of origins)
CLIENT_URL=http://localhost:5173,https://freelancer-client-platform-five.vercel.app

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=skillbridge_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345

# Nodemailer / Email Service
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=mock_mail_user
MAIL_PASSWORD=mock_mail_password
MAIL_FROM=notifications@skillbridge.io

# Default Seed Admin
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@skillbridge.com
ADMIN_PASSWORD=AdminPass123!
